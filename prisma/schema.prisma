generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  users           User[]
  deliveryZones   DeliveryZone[]
  orders          Order[]
  recurringOrders RecurringOrder[]
  patients        Patient[]
  invoices        Invoice[]
  notifications   Notification[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("PHARMACY_ADMIN") // PHARMACY_ADMIN | DRIVER
  phone        String?
  isActive     Boolean  @default(true)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdOrders      Order[]              @relation("OrderCreatedBy")
  assignedDeliveries Order[]              @relation("OrderAssignedDriver")
  defaultZones       DeliveryZone[]       @relation("ZoneDefaultDriver")
  recurringOrders    RecurringOrder[]
  recurringSkips     RecurringOrderSkip[]
  proofsOfDelivery   ProofOfDelivery[]
  generatedInvoices  Invoice[]
}

model Patient {
  id             String   @id @default(cuid())
  name           String
  phone          String?
  address        String
  city           String
  postalCode     String
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  recurringOrders RecurringOrder[]

  @@index([storeId, name])
}

model DeliveryZone {
  id              String   @id @default(cuid())
  name            String
  price           Float
  isActive        Boolean  @default(true)
  defaultDriverId String?
  defaultDriver   User?    @relation("ZoneDefaultDriver", fields: [defaultDriverId], references: [id])
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orders          Order[]
  recurringOrders RecurringOrder[]

  @@unique([name, storeId])
}

model RecurringOrder {
  id                 String   @id @default(cuid())
  patientId          String?
  patient            Patient? @relation(fields: [patientId], references: [id])
  patientName        String
  patientPhone       String?
  deliveryAddress    String
  deliveryCity       String
  deliveryPostalCode String
  deliveryZoneId     String
  deliveryZone       DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  instructions       String?
  activeDays         String   @default("[1]") // JSON array of day numbers 0=Sun..6=Sat, e.g. "[1,2,3,4,5]"
  isOnHold           Boolean  @default(false)
  holdStart          DateTime?
  holdEnd            DateTime?
  isActive           Boolean  @default(true)
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  createdById        String
  createdBy          User     @relation(fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  orders Order[]
  skips  RecurringOrderSkip[]
}

model RecurringOrderSkip {
  id               String         @id @default(cuid())
  recurringOrderId String
  recurringOrder   RecurringOrder @relation(fields: [recurringOrderId], references: [id])
  skipDate         DateTime
  reason           String?
  createdById      String
  createdBy        User           @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())

  @@unique([recurringOrderId, skipDate])
}

model Order {
  id                 String   @id @default(cuid())
  patientName        String
  patientPhone       String?
  deliveryAddress    String
  deliveryCity       String
  deliveryPostalCode String
  deliveryZoneId     String
  deliveryZone       DeliveryZone @relation(fields: [deliveryZoneId], references: [id])
  deliveryZoneName   String
  priceAtCreation    Float
  instructions       String?
  status             String   @default("PENDING") // PENDING | ASSIGNED | IN_TRANSIT | DELIVERED | FAILED | CANCELLED
  failedReason       String?
  attemptCount       Int      @default(1)
  scheduledDate      DateTime
  recurringOrderId   String?
  recurringOrder     RecurringOrder? @relation(fields: [recurringOrderId], references: [id])
  assignedDriverId   String?
  assignedDriver     User?    @relation("OrderAssignedDriver", fields: [assignedDriverId], references: [id])
  storeId            String
  store              Store    @relation(fields: [storeId], references: [id])
  createdById        String
  createdBy          User     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  proofOfDelivery  ProofOfDelivery?
  invoiceLineItems InvoiceLineItem[]
  notifications    Notification[]
}

model ProofOfDelivery {
  id            String   @id @default(cuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  photoUrl      String
  deliveredAt   DateTime @default(now())
  deliveredById String
  deliveredBy   User     @relation(fields: [deliveredById], references: [id])
  notes         String?
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  status        String   @default("DRAFT") // DRAFT | FINALIZED
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id])
  generatedById String
  generatedBy   User     @relation(fields: [generatedById], references: [id])
  createdAt     DateTime @default(now())

  lineItems InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id])
  description String
  amount      Float
}

model Notification {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id])
  type      String   // DELIVERY_FAILED | DELIVERY_REATTEMPT
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
