# Supabase PostgreSQL connection (get from Supabase Dashboard > Settings > Database)
# Use the "Connection string" (Transaction/Session mode) for DATABASE_URL
DATABASE_URL="postgresql://postgres.[your-project-ref]:[4Hbc1OLm9d5j2k2m]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Direct connection" for DIRECT_URL (used for migrations)
DIRECT_URL="postgresql://postgres.[your-project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="generate-a-random-secret-here"
# Set to http://localhost:3000 for local dev, or your Vercel URL for production
AUTH_URL="http://localhost:3000"

# Vercel Cron
# Generate a random value and add the same value in Vercel project environment variables.
CRON_SECRET="generate-a-random-cron-secret-here"

# Google Places address autocomplete
# Server-only key used by API routes. Enable Places API and keep this out of NEXT_PUBLIC vars.
GOOGLE_MAPS_API_KEY="your-google-places-api-key"
